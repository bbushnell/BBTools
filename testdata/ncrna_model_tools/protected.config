# Run from the BBTools installation root. Supply genomes= and out= on the command line.
in=testdata/ncrna_model_tools/genes.fa
ref=resources/callgenes_6S/RF01685/consensus.fa
hbm=resources/callgenes_6S/RF01685/models.hbmc.gz
cutoff=1
target=1
family=sixs_rf01685
truthfamily=fixture
truth=testdata/ncrna_model_tools/panel.truth.tsv
callerconfig=testdata/ncrna_model_tools/caller.config
callerheap=1g
maxcalls=4
